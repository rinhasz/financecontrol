# Copie para .env e preencha — nunca commite o .env de verdade.
#
# Credenciais para a busca de faturas/boletos em email (Outlook/Hotmail via IMAP).
# EMAIL_APP_PASSWORD não é a senha normal da conta — gere uma "senha de aplicativo"
# em https://account.live.com/proofs/AppPassword (Segurança > Opções avançadas de
# segurança > Senhas de aplicativo).

EMAIL_IMAP_HOST=outlook.office365.com
EMAIL_ADDRESS=seuemail@outlook.com
EMAIL_APP_PASSWORD=
